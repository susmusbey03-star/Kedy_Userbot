# 🐾 Kedy UserBot - Örnek Yapılandırma Dosyası
# Bu dosyayı 'config.env' olarak yeniden adlandırın veya kurulum betiğinin doldurmasına izin verin.

# Telegram API Bilgileri (https://my.telegram.org adresinden alınır)
API_KEY = ""
API_HASH = ""

# Sizin Telegram Kullanıcı ID'niz (Owner ID)
OWNER_ID = ""

# Bot Komut Ön Eki (Prefix) - Örnek: .
BOT_PREFIX = "."

# Oturum Dizesi (Terminalde python3 GenerateStringSession.py ile alınır)
STRING_SESSION = ""

# Log Grubu ID'si (İsteğe bağlı, tam sayı olmalı)
BOTLOG_CHATID = 0
BOTLOG = True
